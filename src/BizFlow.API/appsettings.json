{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=BizFlowDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_YOUR_SECURE_KEY_IN_PRODUCTION",
    "Issuer": "BizFlow.API",
    "Audience": "BizFlow.Clients",
    "ExpireMinutes": 60
  }
}
